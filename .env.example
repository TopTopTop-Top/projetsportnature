# Base PostgreSQL (local : docker compose up -d)
DATABASE_URL=postgresql://ravitobox:ravitobox@localhost:5432/ravitobox
# Désactiver SSL pour Postgres local sans TLS
DATABASE_SSL=false

# Render : copier l’URL interne ou externe fournie par la base PostgreSQL
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

JWT_SECRET=change-me-in-production

# Paiements (optionnel — sans clé = mode simulé)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Email reset mdp (optionnel — sans SMTP = code loggé en console)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=RavitoBox <noreply@ravitobox.app>

# Stockage GPX S3/R2 (optionnel — sinon dossier uploads/)
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1
# AWS_S3_PUBLIC_BASE_URL=https://bucket.s3.amazonaws.com
# ou R2_* équivalents
